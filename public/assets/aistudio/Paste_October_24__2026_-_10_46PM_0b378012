<script>
        // Simple drag interaction for the bottom sheet (visual only for this prototype)
        document.addEventListener('DOMContentLoaded', () => {
            const sheet = document.getElementById('bottom-sheet');
            let startY = 0;
            let currentY = 0;
            let isDragging = false;
            
            // Only apply touch logic if on mobile viewport roughly
            if(window.innerWidth < 768) {
                sheet.addEventListener('touchstart', (e) => {
                    const handle = e.target.closest('.cursor-grab');
                    // Only start drag if dragging the top area/handle to allow scrolling inside content
                    if(handle || e.target.tagName.toLowerCase() === 'div' && e.clientY < sheet.getBoundingClientRect().top + 50) {
                        startY = e.touches[0].clientY;
                        isDragging = true;
                        sheet.style.transition = 'none';
                    }
                });

                sheet.addEventListener('touchmove', (e) => {
                    if(!isDragging) return;
                    currentY = e.touches[0].clientY;
                    const diff = currentY - startY;
                    
                    // Only allow dragging down
                    if (diff > 0) {
                        sheet.style.transform = `translateY(${diff}px)`;
                    }
                });

                sheet.addEventListener('touchend', () => {
                    if(!isDragging) return;
                    isDragging = false;
                    sheet.style.transition = 'transform 0.3s ease-out';
                    
                    const diff = currentY - startY;
                    if (diff > 100) {
                        // Dismiss (just hide for prototype)
                        sheet.style.transform = 'translateY(100%)';
                    } else {
                        // Snap back
                        sheet.style.transform = 'translateY(0)';
                    }
                });
            }
        });
