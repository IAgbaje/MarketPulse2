# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION (Optional override for external deployments / GitHub CI)
# In AI Studio, these are loaded automatically from the local (gitignored) firebase-applet-config.json.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"

# GOOGLE MAPS PLATFORM
# Provided automatically in AI Studio or configured via your Google Cloud project.
# Restrict this key to HTTP referrers and Maps JavaScript API, Places API (New), and Routes API.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# GOOGLE ANALYTICS 4 (GA4) — Recommended for private platform-owner traffic analytics
# Example: G-XXXXXXXXXX (invisible to end users; all reports live in your Google Analytics dashboard)
VITE_GA_MEASUREMENT_ID=""

# ADMIN-ONLY USAGE INSIGHTS (Server-side protection for #/usage-analytics)
# Set a strong passphrase to unlock the hidden Admin Usage Insights screen & API endpoints.
ADMIN_ACCESS_CODE=""
# Optional: custom HMAC secret for signing HttpOnly admin session cookies (auto-generated if omitted).
ADMIN_SESSION_SECRET=""
